[
  {
    "name": "empty environment safe shell command defers",
    "payload": {
      "session_id": "thr_fixture",
      "cwd": "{REPO}",
      "hook_event_name": "PreToolUse",
      "tool_name": "Bash",
      "tool_input": {"command": "git status"}
    },
    "env": {},
    "repo_branch": "feature",
    "expected_decision": "pass"
  },
  {
    "name": "empty environment denies push",
    "payload": {
      "session_id": "thr_fixture",
      "cwd": "{REPO}",
      "hook_event_name": "PreToolUse",
      "tool_name": "Bash",
      "tool_input": {"command": "git push origin main"}
    },
    "env": {},
    "repo_branch": "feature",
    "expected_decision": "deny",
    "expected_policy": "loop-vc"
  },
  {
    "name": "deprecated yolo input cannot weaken the conservative baseline",
    "payload": {
      "session_id": "thr_fixture",
      "cwd": "{REPO}",
      "hook_event_name": "PreToolUse",
      "tool_name": "Bash",
      "tool_input": {"command": "git merge --no-ff topic"}
    },
    "env": {"CLAUDE_LOOP_GUARD": "yolo"},
    "repo_branch": "feature",
    "expected_decision": "deny",
    "expected_policy": "loop-vc"
  },
  {
    "name": "main branch multi-file patch is denied",
    "payload": {
      "session_id": "thr_fixture",
      "cwd": "{REPO}",
      "hook_event_name": "PreToolUse",
      "tool_name": "apply_patch",
      "tool_input": {
        "command": "*** Begin Patch\n*** Update File: first.py\n@@\n-old\n+new\n*** Add File: second.py\n+new\n*** End Patch"
      }
    },
    "env": {},
    "repo_branch": "main",
    "expected_targets": ["first.py", "second.py"],
    "expected_decision": "deny",
    "expected_policy": "default-branch"
  },
  {
    "name": "feature branch move enumerates source and destination",
    "payload": {
      "session_id": "thr_fixture",
      "cwd": "{REPO}",
      "hook_event_name": "PreToolUse",
      "tool_name": "apply_patch",
      "tool_input": {
        "command": "*** Begin Patch\n*** Update File: before.py\n*** Move to: after.py\n@@\n-old\n+new\n*** End Patch"
      }
    },
    "env": {},
    "repo_branch": "feature",
    "expected_targets": ["before.py", "after.py"],
    "expected_decision": "pass"
  },
  {
    "name": "empty environment patch cannot rewrite Codex registration",
    "payload": {
      "session_id": "thr_fixture",
      "cwd": "{REPO}",
      "hook_event_name": "PreToolUse",
      "tool_name": "apply_patch",
      "tool_input": {
        "command": "*** Begin Patch\n*** Update File: .codex/hooks.json\n@@\n-old\n+new\n*** End Patch"
      }
    },
    "env": {},
    "repo_branch": "feature",
    "expected_decision": "deny",
    "expected_policy": "self-integrity"
  },
  {
    "name": "unparseable recognized patch denies conservatively",
    "payload": {
      "session_id": "thr_fixture",
      "cwd": "{REPO}",
      "hook_event_name": "PreToolUse",
      "tool_name": "apply_patch",
      "tool_input": {"command": "not an Excubitor-enumerable patch"}
    },
    "env": {},
    "repo_branch": "feature",
    "expected_decision": "deny",
    "expected_policy": "adapter-input"
  },
  {
    "name": "configured MCP move supplies every target to default-branch policy",
    "payload": {
      "session_id": "thr_fixture",
      "cwd": "{REPO}",
      "hook_event_name": "PreToolUse",
      "tool_name": "mcp__filesystem__move_file",
      "tool_input": {"source": "before.py", "destination": "after.py"}
    },
    "policy": "[codex.mcp_mutation_profiles]\n\"mcp__filesystem__move_file\" = [\"/source\", \"/destination\"]\n",
    "env": {},
    "repo_branch": "main",
    "expected_decision": "deny",
    "expected_policy": "default-branch",
    "expected_targets": ["before.py", "after.py"]
  },
  {
    "name": "empty environment configured MCP mutation cannot rewrite Codex registration",
    "payload": {
      "session_id": "thr_fixture",
      "cwd": "{REPO}",
      "hook_event_name": "PreToolUse",
      "tool_name": "mcp__batch__write_files",
      "tool_input": {
        "operations": [
          {"path": "notes.txt", "content": "safe"},
          {"path": ".codex/hooks.json", "content": "disarm"}
        ]
      }
    },
    "policy": "[codex.mcp_mutation_profiles]\n\"mcp__batch__write_files\" = [\"/operations/*/path\"]\n",
    "env": {},
    "repo_branch": "feature",
    "expected_decision": "deny",
    "expected_policy": "self-integrity",
    "expected_targets": ["notes.txt", ".codex/hooks.json"]
  },
  {
    "name": "configured MCP mutation with a missing target denies conservatively",
    "payload": {
      "session_id": "thr_fixture",
      "cwd": "{REPO}",
      "hook_event_name": "PreToolUse",
      "tool_name": "mcp__filesystem__move_file",
      "tool_input": {"source": "before.py"}
    },
    "policy": "[codex.mcp_mutation_profiles]\n\"mcp__filesystem__move_file\" = [\"/source\", \"/destination\"]\n",
    "env": {},
    "repo_branch": "feature",
    "expected_decision": "deny",
    "expected_policy": "adapter-input"
  },
  {
    "name": "configured MCP mutation cannot rewrite its neutral profile",
    "payload": {
      "session_id": "thr_fixture",
      "cwd": "{REPO}",
      "hook_event_name": "PreToolUse",
      "tool_name": "mcp__filesystem__write_file",
      "tool_input": {"path": ".excubitor/policy.toml", "content": "disarm"}
    },
    "policy": "[codex.mcp_mutation_profiles]\n\"mcp__filesystem__write_file\" = [\"/path\"]\n",
